#!/usr/bin/env bash
# Extract a task's — or a contiguous range of tasks' — full text from an
# implementation plan into a file the implementer reads in one call, so the
# task text never has to be pasted through the controller's context.
#
# Only needed for BATCH dispatch (see SKILL.md). The default dispatch is one
# implementer for the whole plan, and that implementer reads the plan file
# itself — no brief to extract.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER|LO-HI [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
#                  <repo-root>/.superpowers/sdd/<plan-basename>/batch-<LO>-<HI>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER|LO-HI [OUTFILE]" >&2
  exit 2
fi

plan=$1
spec=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

case "$spec" in
  [0-9]*-[0-9]*)
    lo=${spec%%-*}
    hi=${spec##*-}
    name="batch-${lo}-${hi}-brief.md"
    ;;
  [0-9]*)
    lo=$spec
    hi=$spec
    name="task-${lo}-brief.md"
    ;;
  *)
    echo "bad task selector: ${spec} (want N or LO-HI)" >&2
    exit 2
    ;;
esac

if [ "$lo" -gt "$hi" ]; then
  echo "bad range: ${spec} (LO must not exceed HI)" >&2
  exit 2
fi

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/$name"
fi

awk -v lo="$lo" -v hi="$hi" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    num = $0
    sub(/^#+[ \t]+Task[ \t]+/, "", num)
    sub(/[^0-9].*$/, "", num)
    intask = (num + 0 >= lo && num + 0 <= hi)
  }
  intask { print }
' "$plan" > "$out"

missing=""
n=$lo
while [ "$n" -le "$hi" ]; do
  if ! grep -Eq "^#+[ 	]+Task[ 	]+${n}([^0-9]|$)" "$out"; then
    missing="${missing}${missing:+, }${n}"
  fi
  n=$((n + 1))
done

if [ -n "$missing" ]; then
  echo "task(s) ${missing} not found in ${plan} (no heading matching 'Task <N>')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
